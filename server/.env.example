# ElevenLabs: speech-to-text (Scribe v2 realtime) and text-to-speech (Flash v2.5)
ELEVENLABS_API_KEY=
# Optional: any voice available to your plan. Defaults to "Bella" (free tier).
ELEVENLABS_VOICE_ID=

# LLM: "openai" (what the demo uses) or "google" (Gemini, free tier)
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# Optional
# ICE_SERVERS=stun:stun.l.google.com:19302
# DB_PATH=./data/clinic.db
